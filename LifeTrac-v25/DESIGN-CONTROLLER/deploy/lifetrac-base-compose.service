# OBSOLETE - DO NOT INSTALL.
#
# May-2026 video-test demo unit (commit 03998936, 2026-05-27), installed and
# enabled on the bench base by tmp_install_base_unit.sh (deleted 2026-10-14).
#
# What it starts at every boot, without a radio GO: the lifetrac-vtest compose
# project from docker-compose.video-test.yml. Its image_rx opens /dev/ttymxc3
# with LIFETRAC_SKIP_RESET_REQ=0 (a soft RESET_REQ on open, which un-parks the
# L072) at LIFETRAC_REG_PROFILE 0 (fixed 915 MHz).
#
# Retired on the bench base 2026-10-12. At both boots that were captured it
# failed or hung on its mosquitto, which wants 127.0.0.1:1883: the bench broker
# design-controller-mosquitto-1 holds it. Stop that broker with this unit
# enabled and the next boot starts image_rx on the radio.
#
# Rules: firmware/x8_lora_bootloader_helper/bench_tools/BENCH_BOARDS.md
# ("Retired boot units"). Record:
# bench-evidence/board_state_2026-10-12_unit_retirement/README.md
[Unit]
Description=LifeTrac base-station video stack (lifetrac-vtest compose project)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lifetrac/DESIGN-CONTROLLER
# NEVER add --build here. Rebuilding in a boot path is a destructive-loop hazard
# (see /memories/repo/lifetrac-base-backend-recovery.md). Build manually with
# `docker compose build` after pulling new code; this unit only brings up
# already-built images.
ExecStart=/usr/bin/docker compose -p lifetrac-vtest -f docker-compose.video-test.yml up -d
ExecStop=/usr/bin/docker compose -p lifetrac-vtest -f docker-compose.video-test.yml down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
