# PLANNED PRODUCTION UNIT - NOT FOR BENCH BOARDS, not installable as written.
#
# Brings up the base compose stack (docker-compose.yml: mosquitto, lora_bridge,
# web_ui, audit_tail). It was installed by hand on the bench base on
# 2026-05-26, failed at every boot (BuildKit export "layer does not exist",
# exit 17) and was retired there on 2026-10-12:
# bench-evidence/board_state_2026-10-12_unit_retirement/README.md
#
# Known problems, to fix before it is installed anywhere:
#   - ExecStart builds on the boot path (--build).
#   - Three services (lora_bridge, web_ui, audit_tail) each build and export
#     the same tag, lifetrac-v25:latest.
#   - ExecStop is a bare `docker compose down` (no -p) = project
#     design-controller, so on a bench base it removes the bench broker.
#   - lora_bridge speaks KISS at 115200 baud, which the Method-G L072 firmware
#     does not implement (docker-compose.video-test.yml, header).
#   - docker-compose.yml:54 uses a single `$`, so compose fills in
#     LIFETRAC_LORA_DEVICE / LIFETRAC_MQTT_HOST from the host .env when it
#     parses the file. Fix that only together with replacing lora_bridge:
#     today the bug is what keeps lora_bridge off the radio.
#
# Redesign item: TODO.md RS-5.11 (in DESIGN-CONTROLLER).
[Unit]
Description=LifeTrac v25 base station (compose stack)
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lifetrac/DESIGN-CONTROLLER
EnvironmentFile=/opt/lifetrac/DESIGN-CONTROLLER/.env
ExecStart=/usr/bin/docker compose up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
