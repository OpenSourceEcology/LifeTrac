# bench.env.example -- settings for every bench script: legs/ (through
# lib/bench_env.sh) and provision_bench_board.sh, flash_l072.sh, deploy_base.sh,
# build_tractor_image.sh, pull_board_state.sh.
#
#   cp bench.env.example bench.env     # then edit bench.env; it is gitignored
#
# All of them load bench.env with the same loader (lib/env_file.sh), with the
# same rules:
#   * BENCH_ENV=<path> (or BENCH_ENV_FILE=<path>) picks another file;
#   * a NON-EMPTY variable already set in the caller's environment wins over the
#     file, so a one-off override is `TRACTOR_SERIAL=... bash flash_l072.sh ...`
#     or `TRACTOR_SERIAL=... bash legs/leg_prep.sh ...`;
#   * an empty value means "use the computed default" (next to each variable).
# Without bench.env the legs/ scripts fall back to THIS file and the setup
# scripts to their built-in defaults; both print a WARN, and both mean the
# original OSE bench's serials and addresses. Create bench.env first.
# Show what the scripts will use: bash -c '. lib/bench_env.sh && bench_show_env'
#
# Bash syntax: VAR=value, no spaces around '='. Quote values with spaces. CRLF
# line endings are tolerated (the loader strips them).
# The defaults below describe the OSE bench of 2026 (BENCH_BOARDS.md); a new
# bench changes at least the two serials and the base address.

# --- boards -----------------------------------------------------------------
# adb serials (`adb devices`). The base talks to the PC over ethernet as well.
BASE_SERIAL=2D0A1209DABC240B
TRACTOR_SERIAL=2E2C1209DABC240B

# How the scripts reach the base: adb (USB) or ssh (ethernet). The tractor is
# adb only (its WiFi is off by policy). Note: run_live_radio_monitor.ps1 itself
# drives both boards over adb, so radio legs need the base on adb too; ssh
# is enough for staging, the power-up guard and the radio-state check.
# flash_l072.sh does not use it: it always flashes the base over ssh.
BASE_TRANSPORT=adb
# Base address and ssh login, used when BASE_TRANSPORT=ssh (and by flash_l072.sh).
BASE_HOST=192.168.1.117
BASE_SSH_USER=fio
# (BASE_USER is the old name. When both are set at the same level, file or
# environment, BASE_SSH_USER wins; an environment BASE_USER still beats the file.)
# Private key for the base (BENCH_SETUP.md). Empty = $HOME/.ssh/lifetrac_base_ed25519
BASE_SSH_KEY=

# sudo password of the `fio` user on both boards. The Arduino default is `fio`;
# BENCH_SETUP.md installs a NOPASSWD sudoers drop-in, after which it is unused.
# Must not contain a single quote.
BENCH_SUDO_PW=fio

# --- PC ---------------------------------------------------------------------
# REQUIRED for radio legs: this PC's LAN IPv4 address as the boards see it,
# passed to the harness as -HostIp (the base rx daemon's control-plane MQTT
# host). The harness's built-in default is the original bench PC's lease, which
# gives a dead control plane anywhere else. Empty = leg_prep.sh looks up this
# PC's IPv4 addresses and uses the only one on BASE_HOST's /24 (or the only one
# at all), prints it, and refuses when that is ambiguous. Set it to be sure.
PC_HOST=

# Scratch space for transcripts and LF-clean copies. Empty = <user temp>/lifetrac-bench
BENCH_SCRATCH=

# Where leg evidence files go (the `legs/` folder of a bench-evidence session).
# Empty = <repo>/LifeTrac-v25/DESIGN-CONTROLLER/bench-evidence/RS_13_vector_scene_<UTC date>/legs
# Set it explicitly for a session that crosses midnight UTC.
EVIDENCE_DIR=

# Private archive OUTSIDE git (board captures, docker image exports).
# Empty = $HOME/Documents/LifeTrac-bench-archive
ARCHIVE_DIR=

# --- radio ------------------------------------------------------------------
# Carrier for every DTS (profile 2) leg, in Hz, picked from a receive-only
# channel spot-check made the SAME DAY with the tractor parked
# (channel_survey_sniff.py or hunt_sniff.ps1, then tools/survey_compare.py;
# RS13_VECTOR_LEG.md "Pin the DTS carrier"). Must lie in 902250000..927750000.
# EMPTY = leg_prep.sh refuses profile-2 legs. 915000000 is refused too: it is
# the channel of the known RS-11.6 external emitter (set DTS_ALLOW_915=1 to
# fly there on purpose).
DTS_CARRIER_HZ=
# Date of that spot-check (YYYY-MM-DD, local). When set, leg_prep.sh refuses a
# DTS leg on any other day; when empty it only warns.
DTS_CARRIER_DATE=

# --- scene (camera legs) ----------------------------------------------------
# Moving content for camera legs: the railroad reference video used since RS-12.
# Use the watch URL; the youtube-nocookie embed fails with Error 153.
YOUTUBE_URL=https://www.youtube.com/watch?v=B1yUQwpNhJA
# Separate Firefox profile for the bench window. Empty = $BENCH_SCRATCH/ff_bench_youtube
FIREFOX_PROFILE_DIR=
# firefox.exe. Empty = look in Program Files, then PATH.
FIREFOX_EXE=

# --- container images on the boards ------------------------------------------
# Base daemon image, built on the base from the deployed tree (DEPLOY.md).
BASE_IMAGE=lifetrac-v25:latest
# Tractor probe/daemon image (= the repo-root foundries_python.tar, docker load -i).
TRACTOR_PROBE_IMAGE=hub.foundries.io/arduino/arduino-ootb-python-devel:738bc44
# Tractor camera image (ffmpeg, numpy, OpenCV), built from firmware/tractor_x8.
TRACTOR_APP_IMAGE=lifetrac-tractor-x8:latest
# The base's MQTT broker container (eclipse-mosquitto:2 on 127.0.0.1:1883).
BASE_BROKER_CONTAINER=design-controller-mosquitto-1

# --- OPTIONAL OVERRIDES (defaults shown; leave commented unless needed) -------
# ADB=adb                                   adb executable for provision_bench_board.sh and
#                                           flash_l072.sh (the other scripts run adb from PATH)
# BASE_DEPLOY_DIR=/var/rootdirs/opt/lifetrac/DESIGN-CONTROLLER   deploy_base.sh target on the base
# BASE_WORK=/home/fio/lifetrac_build         build_tractor_image.sh work dir on the base
#                                           (default /home/<BASE_SSH_USER>/lifetrac_build)
# TRACTOR_USER=fio                           build_tractor_image.sh: the tractor's login user
# TRACTOR_WORK=/home/fio/lifetrac_images     build_tractor_image.sh work dir on the tractor
#                                           (default /home/<TRACTOR_USER>/lifetrac_images;
#                                           both work dirs must end in a lifetrac* directory)
# BOARD_HOME=/home/fio                       flash_l072.sh: where flash logs live on the boards
# REVIVE_MODE=reboot                         flash_l072.sh: reboot or full (full refused on 6.x kernels)
# BENCH_ARCHIVE_DIR                          old name for ARCHIVE_DIR (ARCHIVE_DIR wins)
# DTS_ALLOW_915=0                            1 = let leg scripts run profile 2 on 915.000 MHz (RS-11.6 emitter; don't)
# Fixed, NOT settable: the board staging dirs /tmp/lifetrac_strict and /tmp/lifetrac_p0c
# (run_live_radio_monitor.ps1 hardcodes them).
